# Copy to env/aswitch.env and set real values before deploy.

MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=your-user
MQTT_PASS=your-password
LOG_LEVEL=INFO

# aswitch.py doesn't require extra env keys beyond MQTT.

# audio_activity.py (optional on this host)
AUDIO_DEVICE=plughw:CARD=CODEC,DEV=0
RECORDINGS_DIR=/home/saegey/aswitch/recordings
RECORDING_ATTENUATION_DB=-6.0

# dac_status.py (optional on this host)
DAC_USB_ID=152a:889b
DAC_MATCH_TEXT=Fosi Audio ZD3
DAC_POLL_INTERVAL_SECONDS=5
DAC_STATE_TOPIC=aswitch/dac/zd3/state
DAC_DETAILS_TOPIC=aswitch/dac/zd3/details
DAC_AVAILABILITY_TOPIC=aswitch/dac/zd3/availability
